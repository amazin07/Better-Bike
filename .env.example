# Copy to .env (git-ignored) and fill in. Never commit real keys.

# HERE Traffic API key: HERE platform > Access Manager > Apps > your app >
# Credentials > API Keys > Create API key. No quotes, no spaces around "=".
HERE_API_KEY=

# Hard cap on HERE calls per month. Set it to your real free allowance
# (HERE platform > profile icon > Billing & Usage). 2500 is a placeholder.
HERE_MONTHLY_BUDGET=2500

# Offline UI work: a folder holding here_flow.json and here_incidents.json.
# Costs no budget and overrides HERE_API_KEY. Keep it inside the ignored data/.
# HERE_FIXTURE_DIR=data/here-fixture

# Firebase web app key from Project settings > Your apps. Not a service-account key.
FIREBASE_API_KEY=
# Local testing only, using the demo-bikebetter Auth and Firestore emulators.
# FIREBASE_USE_EMULATORS=1

# Stripe Connect and hosted Checkout: test keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://127.0.0.1:5001
# Local development only: reuse the Firebase CLI account for server Firestore access.
# In deployment, use Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_USE_CLI_CREDENTIALS=1

# Browser-visible test publishable key for the owner notification banner.
STRIPE_PUBLISHABLE_KEY=
# Accounts v2 thin event signature secret (different from Checkout events).
STRIPE_CONNECT_WEBHOOK_SECRET=
