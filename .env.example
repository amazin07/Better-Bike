# Copy to .env (git-ignored) and fill in. Never commit real keys.

# HERE Traffic API key: HERE platform > Access Manager > Apps > your app >
# Credentials > API Keys > Create API key. No quotes, no spaces around "=".
HERE_API_KEY=

# Hard cap on HERE calls per month. Set it to your real free allowance
# (HERE platform > profile icon > Billing & Usage). 2500 is a placeholder.
HERE_MONTHLY_BUDGET=2500

# Offline UI work: a folder holding here_flow.json and here_incidents.json.
# Costs no budget and overrides HERE_API_KEY. Keep it inside the ignored data/.
# HERE_FIXTURE_DIR=data/here-fixture
